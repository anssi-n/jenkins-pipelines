@Library('shared-library') _

def imagesToScan = []

pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  name: image-vuln-scan
  namespace: jenkins-agents
spec:   
  serviceAccountName: jenkins-agent
  nodeSelector:
    jenkins-agent: true
  containers:

  - name: crane
    image: gcr.io/go-containerregistry/crane:debug
    command: ["cat"]
    tty: true
    workingDir: /home/jenkins/agent
    volumeMounts:
    - name: docker-config
      mountPath: /docker-config
    - name: harbor-ca
      mountPath: /etc/ssl/certs/additional-ca-cert-bundle.crt
      subPath: additional-ca-cert-bundle.crt

  - name: trivy
    image: aquasec/trivy:latest
    command: ["cat"]
    tty: true
    workingDir: /home/jenkins/agent
    volumeMounts:
    - name: docker-config
      mountPath: /docker-config
    - name: harbor-ca
      mountPath: /etc/ssl/certs/additional-ca-cert-bundle.crt
      subPath: additional-ca-cert-bundle.crt

  - name: bash
    image: cfmanteiga/alpine-bash-curl-jq:latest
    command: ["cat"]
    tty: true
    workingDir: /home/jenkins/agent
    volumeMounts:
    - name: harbor-ca
      mountPath: /etc/ssl/certs/additional-ca-cert-bundle.crt
      subPath: additional-ca-cert-bundle.crt
      
  - name: cosign
    #image: cgr.dev/chainguard/cosign:latest-dev
    image: ghcr.io/sigstore/cosign/cosign:v3.1.3-dev
    command:
    - "cat"
    tty: true
    securityContext:
      runAsUser: 0
    volumeMounts:
    - name: docker-config
      mountPath: /docker-config
    - name: harbor-ca
      mountPath: /etc/ssl/certs/additional-ca-cert-bundle.crt
      subPath: additional-ca-cert-bundle.crt
      
  volumes:
  - name: docker-config
    secret:      
      secretName: harbor-credentials   
      items:
      - key: .dockerconfigjson
        path: config.json
  - name: harbor-ca
    secret:
      secretName: harbor-ca-cert   
      items:
      - key: ca.crt
        path: additional-ca-cert-bundle.crt
'''
        }
    }
    environment {
        CA_CERT = "/etc/ssl/certs/additional-ca-cert-bundle.crt"
    }
    stages {
        stage('Load target image list') {
            steps {
                script {
                    def config = readYaml file: 'scheduled/image-vuln-scan/images-to-scan.yaml'
                    imagesToScan = config.images
                }
            }
        }
        stage('Perform fresh vulnerability scan for target images') {
            steps {
                container('crane') {
                    script {
                        imagesToScan.each { image ->
                            def safeImage = image.replaceAll('/', '_')
                            echo "Getting image digest for ${image}"
                            sh """
                                echo ${image}
                                DIGEST=\$(crane digest ${image}:latest)
                                echo "\$DIGEST" > /home/jenkins/agent/${safeImage}_digest.txt
                            """
                        } 
                    }                    
                }
                container('trivy') {
                    script {
                        imagesToScan.each { image ->
                            def safeImage = image.replaceAll('/', '_')
                            sh """
                                echo ${image}
                                echo ${safeImage}
                                DIGEST=\$(cat /home/jenkins/agent/${safeImage}_digest.txt)
                                echo \$DIGEST
                                trivy image --format cosign-vuln \
                                    --output /home/jenkins/agent/${safeImage}_vuln.json \
                                    "${image}@\${DIGEST}"                                    
                            """
                        }
                        sh 'ls -ltr /home/jenkins/agent'
                    }
                }
                withVault(vaultSecrets: [
                    [
                        path: 'harbor',
                        engineVersion: 2,
                        secretValues: [
                            [vaultKey: 'admin-username', envVar: 'HARBOR_USERNAME'],
                            [vaultKey: 'admin-password', envVar: 'HARBOR_PASSWORD']
                        ]
                    ]
                ]) {
                    container('bash') {
                        script {
                            withEnv([
                                "CA_CERT=${ca_cert}"
                            ]) {
                                def scriptContent = libraryResource 'scripts/delete_vuln_attestation.sh'
                                writeFile file: 'delete_vuln_attestation.sh', text: scriptContent
                                sh 'chmod +x delete_vuln_attestation.sh'
                                imagesToScan.each { image ->
                                    def safeImage = image.replaceAll('/', '_')
                                    def parts = image.split('/')
                                    def registry = parts[0]
                                    def project  = parts[1]
                                    def repo     = parts[2]
                                    sh """
                                        DIGEST=\$(cat /home/jenkins/agent/${safeImage}_digest.txt)
                                        ./delete_vuln_attestation.sh \
                                            ${registry} \
                                            ${project} \
                                            ${repo} \
                                            \${DIGEST} \
                                            \${CA_CERT}
                                    """
                                }
                            }
                        }
                    }
                }
                withVault(vaultSecrets: [
                    [
                        path: 'cosign',
                        engineVersion: 2,
                        secretValues: [
                            [vaultKey: 'password', envVar: 'COSIGN_PASSWORD'],
                            [vaultKey: 'private_key', envVar: 'COSIGN_KEY_FILE']
                        ]
                    ]
                ]) {
                    container('cosign') {
                        withEnv([
                            "DOCKER_CONFIG=/docker-config"
                        ]) {
                            script {
                                imagesToScan.each { image ->
                                    def safeImage = image.replaceAll('/', '_')
                                    sh """
                                        DIGEST=\$(cat /home/jenkins/agent/${safeImage}_digest.txt)
        
                                        set +x 
                                        echo "\${COSIGN_KEY_FILE}" > /tmp/cosign.key
                                        set -x
            
                                        cosign version
                                        echo "Attest vulnerability scans"
                                        cosign attest --key /tmp/cosign.key \
                                            --type vuln \
                                            --predicate /home/jenkins/agent/${safeImage}_vuln.json \
                                           "${image}@\${DIGEST}"
        
                                        rm -f /tmp/cosign.key
                                    """
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}